# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mompossina_pedidos"

# Firma de sesión (generar un valor aleatorio largo en producción)
SESSION_SECRET="cambia-este-valor-en-produccion"

# Almacenamiento de fotos de producto: "local" o "s3"
STORAGE_DRIVER="local"

# Solo si STORAGE_DRIVER=s3 (o compatible: R2, Spaces, etc.)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_PUBLIC_URL_BASE=""
