# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mompossina_pedidos"

# Firma de sesión (generar un valor aleatorio largo en producción)
SESSION_SECRET="cambia-este-valor-en-produccion"

# Almacenamiento de fotos de producto: "local" o "s3"
STORAGE_DRIVER="local"

# Contraseñas de los usuarios internos que crea "npm run seed" (obligatorias si NODE_ENV=production)
SEED_COMERCIAL_PASSWORD=""
SEED_PRODUCCION_PASSWORD=""

# Solo para entornos de prueba: crea además una empresa y cliente de ejemplo
SEED_DEMO_CLIENT="false"
SEED_CLIENTE_PASSWORD=""

# Notificaciones por correo (Resend). Sin RESEND_API_KEY, el envío se omite sin error.
RESEND_API_KEY=""
EMAIL_FROM="Mompossina Pedidos <onboarding@resend.dev>"

# Solo si STORAGE_DRIVER=s3 (o compatible: R2, Spaces, etc.)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""
S3_PUBLIC_URL_BASE=""
