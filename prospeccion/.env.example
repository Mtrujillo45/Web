# Copia este archivo a ".env" y llena los valores reales.
# NUNCA subas el archivo ".env" real ni el JSON de la cuenta de servicio al repositorio.

# API key de Google Cloud restringida a "Places API (New)"
GOOGLE_PLACES_API_KEY=

# Ruta al archivo JSON de la cuenta de servicio de Google Cloud (con acceso a Sheets API)
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json

# ID de la hoja de Google Sheets donde se escriben los prospectos
# (es el valor largo en la URL: https://docs.google.com/spreadsheets/d/ESTE_ID/edit)
GOOGLE_SHEET_ID=

# Nombre de la pestaña/tab dentro del Sheet donde se agregan los leads
GOOGLE_SHEET_TAB_NAME=Leads
